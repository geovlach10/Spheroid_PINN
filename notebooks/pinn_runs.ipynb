    "from trastuzumab import fdm \n",
    "import numpy as np\n",
    "\n",
    "m = 100     # number of steps.\n",
    "N = m + 1   # number of spatial nodes.\n",
    "y0_up = np.zeros(3 * N)     # initial condition for uptake phase.\n",
    "sol_up, final_up = fdm.run_phase(m=m, phase_name='uptake', y0=y0_up, time_splits=4, t_final=1.0)"
